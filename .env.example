# Copy to .env on the server. Never commit secrets.
MODEL_MODE=external
# Include API prefix, e.g. https://your-provider.example/v1
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT=90
# Set false if the selected service does not support response_format.
MODEL_JSON_MODE=true
# Use true when serving behind HTTPS.
SECURE_COOKIE=false
# DATA_DIR=./data

# Optional website search. Separate from the risk-analysis model above.
# The first supported adapter is Tavily; no credential is shipped.
SEARCH_PROVIDER=tavily
SEARCH_BASE_URL=https://api.tavily.com
SEARCH_API_KEY=
SEARCH_TIMEOUT=60
