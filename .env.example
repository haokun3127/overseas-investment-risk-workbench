# Copy to .env on the server. Never commit secrets.
MODEL_MODE=external
# Include API prefix, e.g. https://your-provider.example/v1
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT=90
# Set false if the selected service does not support response_format.
MODEL_JSON_MODE=true
# Use true when serving behind HTTPS.
SECURE_COOKIE=false
# DATA_DIR=./data

# chat_completions 或 responses
MODEL_WIRE_API=chat_completions
# 默认不保存模型服务端响应状态
MODEL_STORE=false

# Responses 推理强度；留空使用服务默认值
MODEL_REASONING_EFFORT=
